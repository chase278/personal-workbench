# 配置模板：复制本文件为 .env，填入真实值即可运行
#   cp .env.example .env
# .env 已被 .gitignore 排除，绝不会提交到仓库，请放心填写真实密钥。

# 腾讯云 COS（在控制台「访问管理 > API 密钥管理」获取）
COS_SECRET_ID=你的SecretId
COS_SECRET_KEY=你的SecretKey
COS_BUCKET=你的bucket名
COS_REGION=ap-guangzhou
COS_BASE_PATH=workbench

# 服务端口
PORT=3456

# ── 以下为「一键生成周报/月报」功能预留，暂未启用 ──
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
