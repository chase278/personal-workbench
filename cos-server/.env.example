# 配置模板：复制本文件为 .env，填入真实值即可运行
#   cp .env.example .env
# .env 已被 .gitignore 排除，绝不会提交到仓库，请放心填写真实密钥。

# ── 腾讯云 COS 配置（两种方式，任选其一）─────────────────────────
# 方式一：填在本文件（.env）里，启动时自动读取。
# 方式二（推荐新设备用）：不填这里，直接打开工作台网页，
#   在左侧「云同步配置」里填写 SecretId / SecretKey / Bucket / Region，
#   点击「保存并连接」即可，配置会存到 cos-server/.cos-config.json（已被 gitignore 排除）。
# 优先级：环境变量(.env) > .cos-config.json > 开发模式(mock)
#
# COS 密钥在腾讯云控制台「访问管理 > API 密钥管理」获取
COS_SECRET_ID=你的SecretId
COS_SECRET_KEY=你的SecretKey
COS_BUCKET=你的bucket名
COS_REGION=ap-guangzhou
COS_BASE_PATH=workbench

# 服务端口与监听地址
PORT=3456
# 默认只监听本机 127.0.0.1；如需局域网内其他设备访问，改为 0.0.0.0（注意安全风险）
HOST=127.0.0.1

# ── 以下为「一键生成周报」功能预留（当前版本改在网页左侧「大模型配置」中填写）──
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
